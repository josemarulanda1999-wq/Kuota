{
  "appId": "com.kuota.app",
  "appName": "Kuota",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0e0e10",
    "webContentsDebuggingEnabled": false,
    "allowMixedContent": false,
    "useLegacyBridge": true
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "appReadyTimeout": 15000,
      "resetWhenUpdate": true
    }
  }
}
