rules_version = '2';
// KUOTA — reglas multiempresa (reforzadas)
//  · Equipo Kuota (superadmins): todo, desde el portal.
//  · Cada empresa solo ve sus datos, y solo mientras su suscripción esté vigente.
//  · CEO: todo dentro de su empresa (edita y borra). Admin: clientes, préstamos, cobros y cuadre;
//    no ve el dinero del negocio (caja, capital, gastos) ni edita o borra.
//    Cobrador: solo su ruta (pagos y clientes, solicitar renovaciones).
//  · Los usuarios nuevos los activa el equipo Kuota (el CEO solo puede solicitarlos).
//  · Todo lo que crean Admin y Cobrador se valida: ids seguros, tipos, montos positivos y firma.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSuper() { return signedIn() && exists(/databases/$(database)/documents/superadmins/$(uid())); }
    function meDoc() { return /databases/$(database)/documents/users/$(uid()); }
    function hasMe() { return signedIn() && exists(meDoc()); }
    function me() { return get(meDoc()).data; }
    function emp(eid) { return get(/databases/$(database)/documents/empresas/$(eid)).data; }
    function vigente(eid) { return emp(eid).estado == 'activa' && request.time.toMillis() < emp(eid).venceMs; }
    function enEmpresa(eid) { return hasMe() && me().activo == true && me().get('suspendido', false) != true && me().empresaId == eid; }
    function isAdm(eid) { return enEmpresa(eid) && me().rol in ['ceo', 'admin'] && vigente(eid); }
    function isCeo(eid) { return enEmpresa(eid) && me().rol == 'ceo' && vigente(eid); }
    function soloAdmin(eid) { return enEmpresa(eid) && me().rol == 'admin' && vigente(eid); }
    function isCob(eid) { return enEmpresa(eid) && me().rol == 'cobrador' && vigente(eid); }
    function own() { return resource.data.cobradorId == uid(); }
    function ownNew() { return request.resource.data.cobradorId == uid(); }
    function firma() { return request.resource.data.creadoPor == uid(); }
    // el cobrador puede guardar la ubicación de un cliente que no la tiene, pero no moverla
    function ubicFija() {
      return !('lat' in resource.data) || (resource.data.lat == 0 && resource.data.lng == 0)
        || (request.resource.data.get('lat', 0) == resource.data.lat && request.resource.data.get('lng', 0) == resource.data.lng);
    }
    function soloCambiaRuta() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cobradorId']); }

    // ---- validaciones de datos ----
    function idOk(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,40}$'); }
    function idOVacio(v) { return v == '' || idOk(v); }
    function txt(v, max) { return v is string && v.size() <= max; }
    function optTxt(d, k, max) { return !(k in d) || txt(d[k], max); }
    function fechaOk(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function numOk(v, min, max) { return v is number && v >= min && v <= max; }
    function periodoOk(v) { return v in ['DIARIO', 'SEMANAL', 'QUINCENAL', 'MENSUAL']; }
    function optNum(d, k, min, max) { return !(k in d) || numOk(d[k], min, max); }
    function coordsOk(d) { return optNum(d, 'lat', -90, 90) && optNum(d, 'lng', -180, 180); }
    function img(d, k) { return !(k in d) || (d[k] is string && d[k].size() < 340000 && d[k].matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')); }
    // fecha cerca de hoy: hasta 8 días atrás (días pendientes que la ruta abre después) y hasta mañana (en UTC)
    function fechaCerca(f) {
      return fechaOk(f) && timestamp.date(int(f[0:4]), int(f[5:7]), int(f[8:10])) > request.time - duration.value(9, 'd')
        && timestamp.date(int(f[0:4]), int(f[5:7]), int(f[8:10])) < request.time + duration.value(1, 'd');
    }
    // la ruta no puede registrar nada en un día que ya cerró
    function abierta(eid, f) { return !exists(/databases/$(database)/documents/empresas/$(eid)/cierres/$(uid() + '_' + f)); }
    // la ruta abrió ese día y no lo ha cerrado
    function diaAbierto(eid, f) { return exists(/databases/$(database)/documents/empresas/$(eid)/aperturas/$(uid() + '_' + f)) && abierta(eid, f); }
    function cfgRuta(eid) { return get(/databases/$(database)/documents/empresas/$(eid)/rutas/$(uid())).data; }
    function prest(eid, pid) { return get(/databases/$(database)/documents/empresas/$(eid)/prestamos/$(pid)).data; }

    function okCliente(d) {
      return d.keys().hasOnly(['nombre', 'cedula', 'tel1', 'tel2', 'direccion', 'ciudad', 'obs', 'cobradorId', 'lat', 'lng', 'ubicadoEn', 'orden', 'email', 'creado', 'creadoPor'])
        && optTxt(d, 'email', 120)
        && optNum(d, 'orden', 0, 100000)
        && coordsOk(d) && optNum(d, 'ubicadoEn', 0, 99999999999999)
        && txt(d.nombre, 120) && d.nombre.size() > 0
        && optTxt(d, 'cedula', 40) && optTxt(d, 'tel1', 40) && optTxt(d, 'tel2', 40)
        && optTxt(d, 'direccion', 200) && optTxt(d, 'ciudad', 80) && optTxt(d, 'obs', 500)
        && idOVacio(d.cobradorId);
    }
    function okPrestamo(d) {
      return d.keys().hasOnly(['clienteId', 'fecha', 'monto', 'tasa', 'meses', 'periodo', 'excluirDomingos', 'nota', 'cuotas',
                               'valorCuota', 'interesMes', 'total', 'cobradorId', 'renovacionDe', 'saldoCancelado', 'fuente', 'importado', 'castigado', 'modoInteres', 'primeraCuota', 'creado', 'creadoPor'])
        && (!('primeraCuota' in d) || fechaOk(d.primeraCuota))
        && (!('modoInteres' in d) || d.modoInteres in ['total', 'mensual'])
        && (!('fuente' in d) || d.fuente in ['ruta', 'oficina'])
        && idOk(d.clienteId) && fechaOk(d.fecha) && numOk(d.monto, 1, 10000000000) && numOk(d.tasa, 0, 100)
        && numOk(d.meses, 0.001, 1000) && periodoOk(d.periodo) && d.cuotas is int && d.cuotas >= 1 && d.cuotas <= 1000
        && numOk(d.valorCuota, 0.01, 10000000000) && optTxt(d, 'nota', 300) && idOVacio(d.cobradorId)
        && (!('renovacionDe' in d) || idOk(d.renovacionDe)) && (!('saldoCancelado' in d) || numOk(d.saldoCancelado, 0, 10000000000))
        && (!('excluirDomingos' in d) || d.excluirDomingos is bool) && optNum(d, 'interesMes', 0, 100000000000)
        && optNum(d, 'creado', 0, 99999999999999);
    }
    function okPago(d) {
      return d.keys().hasOnly(['prestamoId', 'fecha', 'monto', 'nota', 'tipo', 'cobradorId', 'registradoPor', 'lat', 'lng', 'prec', 'sinGps', 'medio', 'comprobante', 'creado', 'creadoPor', 'editadoPor', 'editadoEn'])
        && optTxt(d, 'editadoPor', 40) && optNum(d, 'editadoEn', 0, 99999999999999)
        && (!('medio' in d) || d.medio in ['efectivo', 'transferencia']) && (!('comprobante' in d) || d.comprobante is bool)
        && coordsOk(d) && optNum(d, 'prec', 0, 100000) && (!('sinGps' in d) || d.sinGps is bool)
        && idOk(d.prestamoId) && fechaOk(d.fecha) && numOk(d.monto, 1, 10000000000) && optTxt(d, 'nota', 300)
        && d.registradoPor == uid() && d.creadoPor == uid();
    }
    function okEntrega(d) {
      return d.keys().hasOnly(['cobradorId', 'fecha', 'valor', 'nota', 'tipo', 'creado', 'creadoPor'])
        && (!('tipo' in d) || d.tipo == 'base')
        && idOk(d.cobradorId) && fechaOk(d.fecha) && numOk(d.valor, 1, 10000000000) && optTxt(d, 'nota', 300);
    }
    function okRenov(d) {
      return d.keys().hasOnly(['prestamoId', 'clienteId', 'cobradorId', 'estado', 'saldoAlSolicitar', 'monto', 'tasa', 'meses', 'periodo',
                               'excluirDomingos', 'nota', 'nuevoPrestamoId', 'saldoCancelado', 'excedente', 'revisadoPor', 'revisadoEn',
                               'fechaRenovacion', 'entregadoPor', 'entregadoEn', 'cuotas', 'modoInteres', 'primeraCuota', 'medioEntrega', 'comprobanteEntrega', 'creado', 'creadoPor'])
        && (!('medioEntrega' in d) || d.medioEntrega in ['efectivo', 'transferencia']) && (!('comprobanteEntrega' in d) || d.comprobanteEntrega is bool)
        && (!('primeraCuota' in d) || d.primeraCuota == '' || fechaOk(d.primeraCuota))
        && idOk(d.prestamoId) && idOk(d.clienteId) && idOVacio(d.cobradorId)
        && numOk(d.monto, 1, 10000000000) && numOk(d.tasa, 0, 100) && numOk(d.meses, 0.001, 1000) && periodoOk(d.periodo)
        && optTxt(d, 'nota', 300);
    }
    // el efectivo a entregar debe ser exactamente nuevo préstamo − lo que se cancela
    function excedenteOk(d) {
      return numOk(d.excedente, 0, 10000000000) && numOk(d.saldoCancelado, 0, 10000000000)
        && (d.monto - d.saldoCancelado - d.excedente) < 1 && (d.monto - d.saldoCancelado - d.excedente) > -1;
    }

    // ---- Kuota ----
    match /meta/super { allow read: if signedIn();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/super) && request.resource.data.uid == uid(); }
    match /superadmins/{sid} {
      allow read: if signedIn() && (sid == uid() || isSuper());
      allow create: if isSuper() || (signedIn() && sid == uid()
        && !exists(/databases/$(database)/documents/meta/super)
        && getAfter(/databases/$(database)/documents/meta/super).data.uid == uid());
      allow update, delete: if isSuper();
    }
    match /meta/kuota { allow read: if signedIn(); allow write: if isSuper(); }
    match /meta/admin { allow read: if isSuper(); }
    match /facturacion/{id} {
      allow read: if isSuper() || (hasMe() && me().activo == true && me().get('suspendido', false) != true && me().rol == 'ceo' && resource.data.empresaId == me().empresaId);
      allow write: if isSuper();
    }

    // ---- usuarios ----
    match /users/{u} {
      allow read: if isSuper() || (signedIn() && u == uid())
        || (hasMe() && resource.data.empresaId == me().empresaId && isAdm(me().empresaId));
      // el CEO solo puede SOLICITAR usuarios (quedan inactivos hasta que Kuota los active)
      allow create: if isSuper()
        || (hasMe() && isCeo(me().empresaId) && u.matches('^[A-Za-z0-9]{10,40}$')
            && request.resource.data.keys().hasOnly(['nombre', 'email', 'rol', 'ruta', 'empresaId', 'activo', 'estado', 'creado', 'creadoPor'])
            && txt(request.resource.data.nombre, 80) && txt(request.resource.data.email, 120) && optTxt(request.resource.data, 'ruta', 60)
            && request.resource.data.empresaId == me().empresaId
            && request.resource.data.activo == false && request.resource.data.estado == 'pendiente'
            && request.resource.data.rol in ['admin', 'cobrador']);
      // el CEO puede cambiar el nombre o desactivar a su gente, pero no activar ni cambiar roles
      allow update: if isSuper()
        || (hasMe() && isCeo(me().empresaId) && resource.data.empresaId == me().empresaId && resource.data.rol != 'ceo'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'ruta', 'activo', 'estado', 'suspendido'])
            && (!('suspendido' in request.resource.data) || request.resource.data.suspendido is bool)
            && txt(request.resource.data.nombre, 80) && optTxt(request.resource.data, 'ruta', 60)
            && (request.resource.data.activo == resource.data.activo || request.resource.data.activo == false)
            && (request.resource.data.estado == resource.data.estado || request.resource.data.estado == 'desactivado'));
      allow delete: if isSuper();
    }

    // ---- empresas ----
    match /empresas/{eid} {
      allow read: if isSuper() || (hasMe() && me().empresaId == eid && me().activo == true && me().get('suspendido', false) != true);
      allow write: if isSuper();

      // config/general la leen todos; config/finanzas (capital) solo el CEO
      match /config/{id} {
        allow read: if isSuper() || (id in ['general', 'marca'] && enEmpresa(eid) && vigente(eid)) || isCeo(eid);
        allow write: if isSuper() || (isCeo(eid) && (id != 'marca' || (request.resource.data.keys().hasOnly(['logo', 'actualizado'])
          && (request.resource.data.get('logo', '') == '' || (request.resource.data.logo is string && request.resource.data.logo.size() < 400000
              && request.resource.data.logo.matches('^data:image/(png|jpeg);base64,[A-Za-z0-9+/=]+$'))))));
      }
      match /clientes/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || isCeo(eid)
          || (idOk(id) && firma() && okCliente(request.resource.data) && (soloAdmin(eid) || (isCob(eid) && ownNew())));
        allow update: if isSuper() || isCeo(eid)
          || (okCliente(request.resource.data) && (soloAdmin(eid) || (isCob(eid) && own() && ownNew() && ubicFija())));
        allow delete: if isSuper() || isCeo(eid);
      }
      match /prestamos/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || isCeo(eid) || (soloAdmin(eid) && idOk(id) && firma() && okPrestamo(request.resource.data))
          // la ruta presta desde su caja, dentro del tope que le fijó la oficina, a sus propios clientes
          || (isCob(eid) && idOk(id) && firma() && okPrestamo(request.resource.data) && ownNew()
              && request.resource.data.get('fuente', '') == 'ruta' && !('renovacionDe' in request.resource.data)
              && !request.resource.data.keys().hasAny(['castigado', 'importado', 'saldoCancelado'])
              && fechaCerca(request.resource.data.fecha)
              && request.resource.data.valorCuota * request.resource.data.cuotas >= request.resource.data.monto
              && (!('total' in request.resource.data) || numOk(request.resource.data.total, request.resource.data.monto, request.resource.data.monto * 5))
              && exists(/databases/$(database)/documents/empresas/$(eid)/rutas/$(uid()))
              && cfgRuta(eid).get('puedePrestar', false) == true && request.resource.data.monto <= cfgRuta(eid).get('maxPrestamo', 0)
              && (cfgRuta(eid).get('maxCuotas', 0) == 0 || request.resource.data.cuotas <= cfgRuta(eid).get('maxCuotas', 0))
              && get(/databases/$(database)/documents/empresas/$(eid)/clientes/$(request.resource.data.clienteId)).data.cobradorId == uid()
              && abierta(eid, request.resource.data.fecha));
        allow update: if isSuper() || isCeo(eid) || (soloAdmin(eid) && soloCambiaRuta() && idOVacio(request.resource.data.cobradorId))
          // semanales: la oficina o la ruta dueña del crédito cambian el día de pago (solo la fecha de la primera cuota)
          || ((soloAdmin(eid) || (isCob(eid) && own())) && resource.data.periodo == 'SEMANAL'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primeraCuota'])
              && fechaOk(request.resource.data.primeraCuota) && request.resource.data.primeraCuota > resource.data.fecha);
        allow delete: if isSuper() || isCeo(eid);
      }
      match /pagos/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || isCeo(eid)
          || (idOk(id) && okPago(request.resource.data)
              && request.resource.data.cobradorId == prest(eid, request.resource.data.prestamoId).get('cobradorId', '')
              && ((soloAdmin(eid) && (!('tipo' in request.resource.data) || request.resource.data.tipo == 'renovacion')
                   && !exists(/databases/$(database)/documents/empresas/$(eid)/cierres/$(request.resource.data.cobradorId + '_' + request.resource.data.fecha)))
                  || (isCob(eid) && ownNew() && !('tipo' in request.resource.data) && fechaCerca(request.resource.data.fecha) && diaAbierto(eid, request.resource.data.fecha))));
        allow update: if isSuper() || isCeo(eid) || (soloAdmin(eid) && soloCambiaRuta() && idOVacio(request.resource.data.cobradorId))
          // la ruta corrige un pago que ella misma registró (p. ej. una cuota adelantada el mismo día), mientras su día siga abierto
          || (isCob(eid) && own() && resource.data.get('registradoPor', '') == uid() && !('tipo' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monto', 'nota', 'medio', 'comprobante', 'editadoPor', 'editadoEn'])
              && request.resource.data.editadoPor == uid() && okPago(request.resource.data)
              && fechaCerca(resource.data.fecha) && abierta(eid, resource.data.fecha));
        allow delete: if isSuper() || isCeo(eid);
      }
      match /entregas/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || isCeo(eid)
          || (soloAdmin(eid) && idOk(id) && firma() && okEntrega(request.resource.data)
              && get(/databases/$(database)/documents/users/$(request.resource.data.cobradorId)).data.empresaId == eid);
        allow update, delete: if isSuper() || isCeo(eid);
      }
      // renovaciones: el cobrador solicita, el Admin o el CEO aprueba, el cobrador marca la entrega del efectivo
      match /renovaciones/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || isCeo(eid)
          || (idOk(id) && firma() && okRenov(request.resource.data)
              && ((isCob(eid) && ownNew() && request.resource.data.estado == 'pendiente'
                   && !request.resource.data.keys().hasAny(['excedente', 'saldoCancelado', 'revisadoPor', 'revisadoEn', 'entregadoPor', 'entregadoEn', 'nuevoPrestamoId'])
                   && prest(eid, request.resource.data.prestamoId).get('cobradorId', '') == uid())
               || (soloAdmin(eid) && request.resource.data.estado == 'entregada' && request.resource.data.entregadoPor == uid()
                   && excedenteOk(request.resource.data))));
        allow update: if isSuper() || isCeo(eid)
          // Admin: aprobar / rechazar una solicitud pendiente, sin cambiar a quién pertenece
          || (soloAdmin(eid) && resource.data.estado == 'pendiente'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'nuevoPrestamoId', 'saldoCancelado', 'excedente',
                   'revisadoPor', 'revisadoEn', 'fechaRenovacion', 'monto', 'tasa', 'meses', 'periodo', 'excluirDomingos', 'nota', 'cuotas', 'modoInteres', 'primeraCuota'])
              && request.resource.data.revisadoPor == uid() && okRenov(request.resource.data)
              && (request.resource.data.estado == 'rechazada' || (request.resource.data.estado == 'aprobada' && excedenteOk(request.resource.data))))
          // Admin o cobrador dueño: marcar que ya entregó el efectivo de una renovación aprobada
          || ((soloAdmin(eid) || (isCob(eid) && own())) && resource.data.estado == 'aprobada' && request.resource.data.estado == 'entregada'
              && request.resource.data.entregadoPor == uid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'entregadoPor', 'entregadoEn', 'medioEntrega', 'comprobanteEntrega'])
              && (!('medioEntrega' in request.resource.data) || request.resource.data.medioEntrega in ['efectivo', 'transferencia'])
              && (!('comprobanteEntrega' in request.resource.data) || request.resource.data.comprobanteEntrega is bool));
        allow delete: if isSuper() || isCeo(eid);
      }
      // GPS: cada persona publica solo su propia ubicación; el CEO y el Admin las ven
      match /ubicaciones/{u} {
        allow read: if isSuper() || isAdm(eid) || (enEmpresa(eid) && u == uid());
        allow create, update: if enEmpresa(eid) && vigente(eid) && u == uid()
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'prec', 't', 'activo', 'nombre', 'rol'])
          && coordsOk(request.resource.data) && optNum(request.resource.data, 'prec', 0, 100000)
          && optNum(request.resource.data, 't', 0, 99999999999999) && optTxt(request.resource.data, 'nombre', 80)
          && optTxt(request.resource.data, 'rol', 20) && (!('activo' in request.resource.data) || request.resource.data.activo is bool);
        allow delete: if isSuper() || isCeo(eid);
      }
      match /recorridos/{rid} {
        allow read: if isSuper() || isAdm(eid) || (enEmpresa(eid) && rid.matches(uid() + '_.*'));
        allow create, update: if enEmpresa(eid) && vigente(eid) && rid.matches(uid() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['uid', 'fecha', 'puntos'])
          && request.resource.data.uid == uid() && fechaOk(request.resource.data.fecha)
          && request.resource.data.puntos is list && request.resource.data.puntos.size() <= 3000;
        allow delete: if isSuper() || isCeo(eid);
      }
      // comprobantes de transferencias (id = id del pago)
      match /comprobantes/{pid} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && resource.data.get('cobradorId', '') == uid());
        allow create: if isSuper() || ((isCeo(eid) || soloAdmin(eid) || (isCob(eid) && request.resource.data.get('cobradorId', '') == uid()
              && prest(eid, request.resource.data.prestamoId).get('cobradorId', '') == uid())) && idOk(pid)
          && request.resource.data.keys().hasOnly(['img', 'prestamoId', 'cobradorId', 'creado', 'creadoPor'])
          && img(request.resource.data, 'img') && idOk(request.resource.data.prestamoId) && request.resource.data.creadoPor == uid());
        allow update, delete: if isSuper() || isCeo(eid);
      }
      // ---- operación diaria de las rutas ----
      match /rutas/{u} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && u == uid());
        allow delete: if isSuper() || isCeo(eid);
        allow create, update: if isSuper() || ((isCeo(eid) || (soloAdmin(eid) && resource != null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puedeDominical', 'actualizado']))) && idOk(u)
          && request.resource.data.keys().hasOnly(['cobradorId', 'puedePrestar', 'maxPrestamo', 'maxGasto', 'salario', 'periodoPago', 'pctRecaudo', 'pctVentas', 'maxCuotas', 'maxRenov', 'puedeDominical', 'actualizado'])
          && (!('puedeDominical' in request.resource.data) || request.resource.data.puedeDominical is bool)
          && request.resource.data.cobradorId == u && request.resource.data.puedePrestar is bool
          && get(/databases/$(database)/documents/users/$(u)).data.empresaId == eid
          && get(/databases/$(database)/documents/users/$(u)).data.rol == 'cobrador'
          && optNum(request.resource.data, 'salario', 0, 10000000000) && optNum(request.resource.data, 'pctRecaudo', 0, 100)
          && optNum(request.resource.data, 'pctVentas', 0, 100) && optNum(request.resource.data, 'maxCuotas', 0, 1000)
          && optNum(request.resource.data, 'maxRenov', 0, 1000)
          && numOk(request.resource.data.maxPrestamo, 0, 10000000000) && numOk(request.resource.data.maxGasto, 0, 10000000000));
      }
      match /movruta/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || isCeo(eid) || (idOk(id) && firma()
          && request.resource.data.keys().hasOnly(['cobradorId', 'fecha', 'tipo', 'concepto', 'valor', 'nota', 'lat', 'lng', 'prec', 'sinGps', 'creado', 'creadoPor'])
          && idOk(request.resource.data.cobradorId) && fechaOk(request.resource.data.fecha) && request.resource.data.tipo in ['gasto', 'ingreso']
          && txt(request.resource.data.concepto, 40) && numOk(request.resource.data.valor, 0.01, 10000000000) && optTxt(request.resource.data, 'nota', 200) && coordsOk(request.resource.data)
          && ((soloAdmin(eid) && get(/databases/$(database)/documents/users/$(request.resource.data.cobradorId)).data.empresaId == eid)
              || (isCob(eid) && ownNew() && fechaCerca(request.resource.data.fecha) && diaAbierto(eid, request.resource.data.fecha)
                  && (request.resource.data.tipo == 'ingreso' || !exists(/databases/$(database)/documents/empresas/$(eid)/rutas/$(uid()))
                      || cfgRuta(eid).get('maxGasto', 0) == 0 || request.resource.data.valor <= cfgRuta(eid).get('maxGasto', 0)))));
        allow update, delete: if isSuper() || isCeo(eid);
      }
      match /visitas/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || isCeo(eid) || (idOk(id) && firma()
          && request.resource.data.keys().hasOnly(['prestamoId', 'clienteId', 'cobradorId', 'fecha', 'resultado', 'motivo', 'volver', 'nota', 'lat', 'lng', 'prec', 'sinGps', 'creado', 'creadoPor'])
          && idOk(request.resource.data.prestamoId) && idOk(request.resource.data.clienteId) && fechaOk(request.resource.data.fecha)
          && request.resource.data.resultado in ['nopago', 'aplazado', 'dominical'] && txt(request.resource.data.motivo, 60) && optTxt(request.resource.data, 'nota', 200)
          && (request.resource.data.get('volver', '') == '' || fechaOk(request.resource.data.volver)) && coordsOk(request.resource.data)
          && request.resource.data.cobradorId == prest(eid, request.resource.data.prestamoId).get('cobradorId', '')
          && (soloAdmin(eid) || (isCob(eid) && ownNew() && abierta(eid, request.resource.data.fecha)
              && (request.resource.data.resultado != 'dominical' || cfgRuta(eid).get('puedeDominical', false) == true))));
        allow update, delete: if isSuper() || isCeo(eid);
      }
      match /cierres/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || ((isCeo(eid) || soloAdmin(eid) || (isCob(eid) && ownNew() && fechaCerca(request.resource.data.fecha)))
          && id == request.resource.data.cobradorId + '_' + request.resource.data.fecha && idOk(request.resource.data.cobradorId)
          && fechaOk(request.resource.data.fecha) && request.resource.data.keys().hasOnly(['cobradorId', 'fecha', 'cerradoEn', 'resumen'])
          && request.resource.data.resumen is map && request.resource.data.resumen.size() <= 30);
        allow delete: if isSuper() || isCeo(eid) || soloAdmin(eid);
      }
      // apertura del día: la ruta abre su día antes de cobrar (id = cobrador_fecha); la oficina también la puede abrir
      match /aperturas/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || ((isCeo(eid) || soloAdmin(eid) || (isCob(eid) && ownNew() && fechaCerca(request.resource.data.fecha)))
          && id == request.resource.data.cobradorId + '_' + request.resource.data.fecha && idOk(request.resource.data.cobradorId)
          && fechaOk(request.resource.data.fecha) && request.resource.data.keys().hasOnly(['cobradorId', 'fecha', 'abiertaEn', 'por', 'lat', 'lng', 'prec'])
          && optNum(request.resource.data, 'abiertaEn', 0, 99999999999999) && coordsOk(request.resource.data) && optNum(request.resource.data, 'prec', 0, 100000)
          && request.resource.data.get('por', '') == uid()
          && get(/databases/$(database)/documents/users/$(request.resource.data.cobradorId)).data.empresaId == eid);
        allow delete: if isSuper() || isCeo(eid) || soloAdmin(eid);
      }
      match /aprobaciones/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || isCeo(eid) || (isCob(eid) && idOk(id) && firma() && ownNew()
          && request.resource.data.keys().hasOnly(['tipo', 'cobradorId', 'clienteId', 'monto', 'tasa', 'meses', 'cuotas', 'modoInteres', 'periodo', 'excluirDomingos', 'nota', 'fecha', 'estado', 'prestamoId', 'primeraCuota', 'creado', 'creadoPor'])
          && (!('primeraCuota' in request.resource.data) || fechaOk(request.resource.data.primeraCuota))
          && request.resource.data.tipo == 'prestamo' && request.resource.data.estado == 'pendiente' && idOk(request.resource.data.clienteId)
          && numOk(request.resource.data.monto, 1, 10000000000) && numOk(request.resource.data.tasa, 0, 100) && numOk(request.resource.data.meses, 0.001, 1000)
          && periodoOk(request.resource.data.periodo) && optTxt(request.resource.data, 'nota', 300) && (!('prestamoId' in request.resource.data) || idOk(request.resource.data.prestamoId))
          && get(/databases/$(database)/documents/empresas/$(eid)/clientes/$(request.resource.data.clienteId)).data.cobradorId == uid());
        allow update: if isSuper() || isCeo(eid) || (soloAdmin(eid) && resource.data.estado == 'pendiente'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'prestamoId', 'revisadoPor', 'revisadoEn'])
          && request.resource.data.estado in ['aprobada', 'rechazada'] && request.resource.data.revisadoPor == uid());
        allow delete: if isSuper() || isCeo(eid);
      }
      // capital destinado a cada ruta: solo el CEO lo asigna
      match /caprutas/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || (isCeo(eid) && idOk(id) && firma()
          && request.resource.data.keys().hasOnly(['cobradorId', 'fecha', 'valor', 'nota', 'creado', 'creadoPor'])
          && idOk(request.resource.data.cobradorId) && fechaOk(request.resource.data.fecha)
          && numOk(request.resource.data.valor, -100000000000, 100000000000) && optTxt(request.resource.data, 'nota', 200)
          && get(/databases/$(database)/documents/users/$(request.resource.data.cobradorId)).data.empresaId == eid);
        allow update, delete: if isSuper() || isCeo(eid);
      }
      // registro de avisos enviados a clientes (WhatsApp / correo)
      match /avisos/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || (enEmpresa(eid) && vigente(eid) && idOk(id) && firma()
          && request.resource.data.keys().hasOnly(['prestamoId', 'clienteId', 'cobradorId', 'tipo', 'canal', 'fecha', 'creado', 'creadoPor'])
          && request.resource.data.tipo in ['recordatorio', 'mora', 'pazysalvo'] && request.resource.data.canal in ['whatsapp', 'correo']
          && fechaOk(request.resource.data.fecha) && (isAdm(eid) || ownNew()));
        allow update, delete: if isSuper() || isCeo(eid);
      }
      // notas de la oficina para cada ruta
      match /notas/{id} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && own());
        allow create: if isSuper() || ((isCeo(eid) || soloAdmin(eid)) && idOk(id) && firma()
          && request.resource.data.keys().hasOnly(['cobradorId', 'texto', 'fecha', 'leida', 'creado', 'creadoPor'])
          && idOk(request.resource.data.cobradorId) && txt(request.resource.data.texto, 300) && request.resource.data.leida == false
          && get(/databases/$(database)/documents/users/$(request.resource.data.cobradorId)).data.empresaId == eid);
        allow update: if isSuper() || isAdm(eid) || (isCob(eid) && own()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']) && request.resource.data.leida == true);
        allow delete: if isSuper() || isCeo(eid);
      }
      // auditoría: cualquiera de la empresa deja constancia de lo que hace; solo el CEO la lee; nadie la cambia
      match /auditoria/{id} {
        allow read: if isSuper() || isCeo(eid);
        allow create: if enEmpresa(eid) && request.resource.data.por == uid()
          && request.resource.data.keys().hasOnly(['accion', 'col', 'docId', 'detalle', 'por', 'nombre', 't', 'fecha'])
          && txt(request.resource.data.accion, 20) && txt(request.resource.data.col, 40) && txt(request.resource.data.detalle, 200) && optTxt(request.resource.data, 'nombre', 80)
          && optTxt(request.resource.data, 'docId', 60) && optNum(request.resource.data, 't', 0, 99999999999999) && optTxt(request.resource.data, 'fecha', 10);
        allow update, delete: if false;
      }
      // equipo autorizado de cada ruta: se registra solo una vez; solo el CEO lo libera
      match /equipos/{u} {
        allow get: if isSuper() || isAdm(eid) || (enEmpresa(eid) && u == uid());
        allow list: if isSuper() || isAdm(eid);
        allow create: if enEmpresa(eid) && vigente(eid) && u == uid()
          && request.resource.data.keys().hasOnly(['dev', 'modelo', 'plataforma', 'registrado', 'ultimoUso'])
          && request.resource.data.dev is string && request.resource.data.dev.size() >= 16 && request.resource.data.dev.size() <= 128
          && optTxt(request.resource.data, 'modelo', 80) && optTxt(request.resource.data, 'plataforma', 20);
        allow update: if enEmpresa(eid) && u == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoUso'])
          && request.resource.data.ultimoUso is number;
        allow delete: if isSuper() || isCeo(eid);
      }
      match /intentos/{id} {
        allow read: if isSuper() || isAdm(eid);
        allow create: if enEmpresa(eid) && request.resource.data.uid == uid()
          && request.resource.data.keys().hasOnly(['uid', 'nombre', 'modelo', 'plataforma', 't'])
          && optTxt(request.resource.data, 'nombre', 80) && optTxt(request.resource.data, 'modelo', 80) && optTxt(request.resource.data, 'plataforma', 20);
        allow delete: if isSuper() || isCeo(eid);
      }
      // fotos del cliente y la cédula, guardadas por crédito (id = id del préstamo)
      match /fotos/{pid} {
        allow read: if isSuper() || isAdm(eid) || (isCob(eid) && (resource.data.get('cobradorId', '') == uid() || prest(eid, pid).get('cobradorId', '') == uid()));
        allow create, update: if isSuper() || ((isCeo(eid) || soloAdmin(eid) || (isCob(eid) && request.resource.data.get('cobradorId', '') == uid()
              && (resource == null || resource.data.get('cobradorId', '') == uid()))) && idOk(pid)
          && request.resource.data.keys().hasOnly(['foto', 'cedula', 'cedulaReverso', 'clienteId', 'cobradorId', 'creado', 'creadoPor'])
          && idOk(request.resource.data.clienteId) && request.resource.data.creadoPor == uid()
          && img(request.resource.data, 'foto') && img(request.resource.data, 'cedula') && img(request.resource.data, 'cedulaReverso')
          && (!isCob(eid) || !exists(/databases/$(database)/documents/empresas/$(eid)/prestamos/$(pid)) || prest(eid, pid).get('cobradorId', '') == uid()));
        allow delete: if isSuper() || isCeo(eid);
      }
      // el dinero del negocio (gastos, ingresos extra y capital) solo lo ve el CEO
      match /salidas/{id} {
        allow read, update, delete: if isSuper() || isCeo(eid);
        allow create: if isSuper() || (isCeo(eid) && firma());
      }
      match /ingresos/{id} {
        allow read, update, delete: if isSuper() || isCeo(eid);
        allow create: if isSuper() || (isCeo(eid) && firma());
      }
      match /capital/{id} {
        allow read, write: if isSuper() || isCeo(eid);
      }
      // el equipo Kuota puede borrar todos los datos de una empresa (eliminar empresa desde el portal)
      match /{col}/{doc=**} {
        allow read, delete: if isSuper();
      }
    }

    // ---- datos de la primera versión (solo para moverlos desde el portal) ----
    match /{col}/{id} {
      allow read, delete: if isSuper() && col in ['clientes', 'prestamos', 'pagos', 'salidas', 'capital', 'ingresos', 'entregas', 'config'];
    }
  }
}
